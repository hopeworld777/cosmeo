{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://striking-blessing-production-178d.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://striking-blessing-production-178d.up.railway.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).avif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/avif"
        }
      ]
    }
  ]
}
