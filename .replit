modules = ["nodejs-20", "postgresql-16", "python-base-3.13"]
[agent]
expertMode = true
integrations = ["replitmail:1.0.0"]
stack = "FULLSTACK_JS"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/index.js"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
JWT_SECRET = "7dfe43970d8f9b6189ec3505cd232e24e930186d0b8606b37f86aed86ca097ff"

[userenv.development]
NODE_ENV = "development"
PORT = "3001"
